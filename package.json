{
  "name": "minidsh",
  "version": "1.0.0",
  "description": "Minimal surface, complete architecture: a small, local-first coding-agent harness re-derived from the invariants of DeepSeek Harness (independent project; not affiliated).",
  "keywords": [
    "agent",
    "agent-harness",
    "coding-agent",
    "ai-agent",
    "llm",
    "deepseek",
    "anthropic",
    "sandbox",
    "event-sourcing",
    "plugin-architecture",
    "local-first",
    "json-rpc",
    "cli"
  ],
  "homepage": "https://github.com/earthwalker17/MiniDSH#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earthwalker17/MiniDSH.git"
  },
  "bugs": {
    "url": "https://github.com/earthwalker17/MiniDSH/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "minidsh": "./bin/minidsh.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "minidsh": "node bin/minidsh.js",
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "prepublishOnly": "pnpm check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src scripts",
    "check:deps": "node scripts/check-deps.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:deps && pnpm test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
